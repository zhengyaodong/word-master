<!-- 查词页面 -->
<view class="container">
  <!-- 搜索区域 -->
  <view class="search-section">
    <view class="search-box">
      <input 
        class="search-input" 
        placeholder="输入英文单词查询" 
        value="{{inputWord}}"
        bindinput="onInputChange"
        bindconfirm="onSearch"
        confirm-type="search"
      />
      <button class="search-btn" bindtap="onSearch" loading="{{isLoading}}">
        {{isLoading ? '查询中' : '查询'}}
      </button>
    </view>
    
    <!-- 最近查询 -->
    <view class="history-section" wx:if="{{history.length > 0}}">
      <view class="section-title">
        <text>最近查询</text>
        <text class="clear-btn" bindtap="clearHistory">清空</text>
      </view>
      <view class="history-list">
        <view 
          class="history-item" 
          wx:for="{{history}}" 
          wx:key="index"
          bindtap="onHistoryTap"
          data-word="{{item.word}}"
        >
          {{item.word}}
        </view>
      </view>
    </view>
  </view>

  <!-- 查询结果 -->
  <view class="result-section" wx:if="{{queryResult}}">
    <view class="word-card">
      <!-- 单词标题 -->
      <view class="word-header">
        <text class="word-title">{{queryResult.word}}</text>
        <text class="word-phonetic">{{queryResult.phonetic}}</text>
        <text class="word-pos">{{queryResult.part_of_speech}}</text>
      </view>

      <!-- 释义 -->
      <view class="definition-section">
        <view class="section-title">中文释义</view>
        <text class="definition-text">{{queryResult.definition}}</text>
        
        <view class="section-title" wx:if="{{queryResult.english_definition}}">英文释义</view>
        <text class="english-definition" wx:if="{{queryResult.english_definition}}">
          {{queryResult.english_definition}}
        </text>
      </view>

      <!-- 例句 -->
      <view class="examples-section" wx:if="{{queryResult.examples && queryResult.examples.length > 0}}">
        <view class="section-title">例句</view>
        <view class="example-item" wx:for="{{queryResult.examples}}" wx:key="index">
          <text class="example-sentence">{{item.sentence}}</text>
          <text class="example-translation">{{item.translation}}</text>
        </view>
      </view>

      <!-- 记忆技巧 -->
      <view class="memory-section" wx:if="{{queryResult.memory_tips}}">
        <view class="section-title">记忆技巧</view>
        <text class="memory-text">{{queryResult.memory_tips}}</text>
      </view>

      <!-- 操作按钮 -->
      <view class="action-section">
        <button 
          class="action-btn add-btn" 
          bindtap="addToVocabBook"
          disabled="{{isInVocabBook}}"
          type="{{isInVocabBook ? 'default' : 'primary'}}"
        >
          {{isInVocabBook ? '已在生词本' : '加入生词本'}}
        </button>
        <button class="action-btn share-btn" open-type="share">分享</button>
      </view>

      <!-- 缓存提示 -->
      <view class="cache-tip" wx:if="{{queryResult.from_cache}}">
        <text>来自缓存</text>
      </view>
    </view>
  </view>

  <!-- 空状态 -->
  <view class="empty-state" wx:if="{{!queryResult && !isLoading}}">
    <text class="empty-title">输入单词开始查询</text>
    <text class="empty-desc">使用AI智能解释单词</text>
  </view>
</view>
